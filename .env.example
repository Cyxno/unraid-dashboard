# Base URL of your Unraid server's GraphQL API.
# Unraid 7.2+ (built-in API):  http://<tower-ip>          (WebGUI port, API served at /graphql)
# Standalone Unraid API plugin/container: http://<tower-ip>:3005
UNRAID_URL=http://tower.local

# API key created in the Unraid WebGUI (Settings -> Management Access -> API).
# Server-side only: it is never sent to the browser.
UNRAID_API_KEY=

# Optional: Prometheus server for time-series metrics, history and thermals.
# When unset, the dashboard still serves all Unraid state and marks
# Prometheus-derived widgets as unavailable. No credentials are sent.
# The Prometheus server must be reachable from the dashboard container
# (e.g. host networking + published port: http://127.0.0.1:9090).
# PROMETHEUS_URL=http://127.0.0.1:9090
# PROMETHEUS_TIMEOUT_MS=5000

# Optional overrides
# UNRAID_TIMEOUT_MS=10000
# UNRAID_GRAPHQL_PATH=/graphql

# ---- authentication (optional; default = trusted LAN mode) ----
# AUTH_MODE=disabled|proxy. In proxy mode requests must arrive via your
# reverse proxy, which injects the identity header below.
# AUTH_MODE=proxy
# AUTH_HEADER=X-Forwarded-User
# Optional comma-separated identity allowlist (empty = any authenticated user).
# AUTH_ALLOWED_USERS=youruser
# Comma-separated proxies/CIDRs (documentation value; see the trust model in
# docs/SECURITY.md).
# AUTH_TRUSTED_PROXIES=172.17.0.0/16

# ---- write actions (default OFF) ----
# Separate, narrowly scoped Unraid key: DOCKER:UPDATE_ANY permission ONLY.
# Never reuse the read key here — Beacon needs no other write access.
# unraid-api apikey --create --name "beacon actions" \
#   --permissions "DOCKER:UPDATE_ANY"
# UNRAID_ACTION_API_KEY=
# ENABLE_ACTIONS=false
# ACTION_COOLDOWN_MS=10000
# ACTION_RATE_PER_MINUTE=12
# AUDIT_DIR=/app/data

# ---- optional GHCR update check (read:packages token) ----
# GHCR_TOKEN=

# ---- update helper (localhost-only, single-purpose) ------------------------
# The helper is the only component with Docker access. Deploy once:
#   UPDATE_HELPER_TOKEN=$(openssl rand -hex 32) scripts/deploy-helper.sh
# Then share the SAME token with the dashboard (never exposed to the browser).
# UPDATE_HELPER_URL=http://127.0.0.1:8790
# UPDATE_HELPER_TOKEN=change-me-at-least-32-chars

# ---- proxy-auth shared secret (AUTH_MODE=proxy only) -----------------------
# The reverse proxy injects this as X-Dashboard-Auth-Token along with the
# identity header; requests without it are rejected (fail-closed). Generate:
#   openssl rand -hex 32
# AUTH_PROXY_SECRET=change-me-at-least-16-chars
# AUTH_PROXY_SECRET_HEADER=X-Dashboard-Auth-Token

# ---- central Docker update manager (detection) ------------------------------
# Containers deployed via an operator-owned script (comma-separated names).
# The script itself must be allowlisted on the update helper at deploy time
# (DEPLOY_SCRIPT_* env) — the dashboard never executes anything itself.
# CUSTOM_DEPLOY_CONTAINERS=my-deployed-app,unraid-dashboard-helper
# Extra container name fragments treated as HIGH risk (comma-separated);
# databases/auth/proxy/DNS patterns are always HIGH risk automatically.
# HIGH_RISK_CONTAINERS=
