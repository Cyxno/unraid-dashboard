# Base URL of your Unraid server's GraphQL API.
# Unraid 7.2+ (built-in API):  http://<tower-ip>          (WebGUI port, API served at /graphql)
# Standalone Unraid API plugin/container: http://<tower-ip>:3005
UNRAID_URL=http://tower.local

# API key created in the Unraid WebGUI (Settings -> Management Access -> API).
# Server-side only: it is never sent to the browser.
UNRAID_API_KEY=

# Optional: Prometheus server for time-series metrics, history and thermals.
# When unset, the dashboard still serves all Unraid state and marks
# Prometheus-derived widgets as unavailable. No credentials are sent.
# The Prometheus server must be reachable from the dashboard container
# (e.g. host networking + published port: http://127.0.0.1:9090).
# PROMETHEUS_URL=http://127.0.0.1:9090
# PROMETHEUS_TIMEOUT_MS=5000

# Optional overrides
# UNRAID_TIMEOUT_MS=10000
# UNRAID_GRAPHQL_PATH=/graphql

# ---- v0.4: authentication (optional; default = trusted LAN mode) ----
# AUTH_MODE=disabled|proxy. In proxy mode requests must arrive via your
# reverse proxy, which injects the identity header below.
# AUTH_MODE=proxy
# AUTH_HEADER=X-Forwarded-User
# Optional comma-separated identity allowlist (empty = any authenticated user).
# AUTH_ALLOWED_USERS=remco
# Comma-separated proxies/CIDRs (documentation value; see README trust model).
# AUTH_TRUSTED_PROXIES=172.17.0.0/16

# ---- v0.4: write actions (default OFF) ----
# Separate, narrowly scoped Unraid key: GUEST role + DOCKER:UPDATE_ANY +
# VMS:UPDATE_ANY permissions ONLY. Never reuse the read key here.
# unraid-api apikey --create --name "unraid dashboard actions" \
#   --roles GUEST --permissions "DOCKER:UPDATE_ANY,VMS:UPDATE_ANY"
# UNRAID_ACTION_API_KEY=
# ENABLE_ACTIONS=false
# ACTION_COOLDOWN_MS=10000
# ACTION_RATE_PER_MINUTE=12
# AUDIT_DIR=/app/data

# ---- v0.4: optional GHCR update check (read:packages token) ----
# GHCR_TOKEN=
