# Base URL of your Unraid server's GraphQL API.
# Unraid 7.2+ (built-in API):  http://<tower-ip>          (WebGUI port, API served at /graphql)
# Standalone Unraid API plugin/container: http://<tower-ip>:3005
UNRAID_URL=http://tower.local

# API key created in the Unraid WebGUI (Settings -> Management Access -> API).
# Server-side only: it is never sent to the browser.
UNRAID_API_KEY=

# Optional: Prometheus server for time-series metrics, history and thermals.
# When unset, the dashboard still serves all Unraid state and marks
# Prometheus-derived widgets as unavailable. No credentials are sent.
# The Prometheus server must be reachable from the dashboard container
# (e.g. host networking + published port: http://127.0.0.1:9090).
# PROMETHEUS_URL=http://127.0.0.1:9090
# PROMETHEUS_TIMEOUT_MS=5000

# Optional overrides
# UNRAID_TIMEOUT_MS=10000
# UNRAID_GRAPHQL_PATH=/graphql
